		"@types/three": "^0.186.0",
		"fontkit": "^2.0.4",
		"lil-gui": "^0.21.0",
		"playwright": "^1.63.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
